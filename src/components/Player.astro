---
// src/components/Player.astro
interface Props {
    currentShow: string;
    djName?: string;
}

const { 
    currentShow = "n8v Selection", 
    djName = "n8v DJ" 
} = Astro.props;

// Combining them for the scrolling marquee
const displayInfo = `${djName} - ${currentShow}`.toUpperCase();
---

<div class="fixed bottom-0 left-0 w-full bg-brand-dark z-[100] px-5 py-4 md:py-5 border-t border-white/10 shadow-[0_-20px_50px_rgba(0,0,0,0.9)] transform translate-z-0" transition:persist>
    
    <div class="container mx-auto flex items-center justify-between md:grid md:grid-cols-3 max-w-7xl">
        
        <div class="flex items-center gap-4 min-w-0 pr-4">
            <div class="relative w-14 h-14 md:w-16 md:h-16 flex-shrink-0 bg-zinc-900/90 rounded-xl overflow-hidden flex items-center justify-center border border-white/10 shadow-2xl group">
                <!-- Pro DJ Turntable Vector (Technics SL-1200 Style) -->
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-11 h-11 md:w-12 md:h-12 transition-transform duration-300 group-hover:scale-105">
                    <!-- Turntable Platter & Vinyl Record (Spins when active) -->
                    <g id="player-vinyl" class="animate-spin-slow pause-spin" style="transform-origin: 27px 32px;">
                        <!-- Outer platter rim -->
                        <circle cx="27" cy="32" r="22" fill="#09090b" stroke="#27272a" stroke-width="1.5"/>
                        <!-- Vinyl Grooves -->
                        <circle cx="27" cy="32" r="18" stroke="#1c1c20" stroke-width="1.2"/>
                        <circle cx="27" cy="32" r="14" stroke="#18181b" stroke-width="1"/>
                        <circle cx="27" cy="32" r="10" stroke="#222226" stroke-width="0.75" stroke-dasharray="3 2"/>
                        <!-- Center Label (Red n8v Record) -->
                        <circle cx="27" cy="32" r="7" fill="#ff3b3b"/>
                        <!-- Center Spindle -->
                        <circle cx="27" cy="32" r="1.75" fill="#ffffff"/>
                    </g>
                    <!-- Tonearm Assembly (Positioned over the vinyl groove) -->
                    <circle cx="53" cy="16" r="4.5" fill="#27272a" stroke="#3f3f46" stroke-width="1.2"/>
                    <circle cx="53" cy="16" r="2" fill="#a1a1aa"/>
                    <!-- Metallic Tonearm Stem -->
                    <path d="M53 16 L50 33 L40 40" stroke="#d4d4d8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <!-- Cartridge / Stylus Resting on Groove -->
                    <rect x="36" y="38" width="6" height="3" rx="1" transform="rotate(-35 39 39.5)" fill="#ff3b3b"/>
                    <!-- Power Strobe Indicator -->
                    <circle cx="8" cy="51" r="2" fill="#ff3b3b"/>
                    <!-- Pitch Slider -->
                    <rect x="54" y="30" width="2" height="18" rx="1" fill="#27272a"/>
                    <rect x="53" y="38" width="4" height="2.5" rx="0.5" fill="#e4e4e7"/>
                </svg>

                <div id="player-status-icon" class="absolute inset-0 bg-black/45 hidden items-center justify-center backdrop-blur-[1px]">
                    <i class="fa-solid fa-chart-simple text-white text-base md:text-lg animate-pulse drop-shadow-[0_0_8px_rgba(255,59,59,0.9)]"></i>
                </div>
            </div>
            
            <div class="flex flex-col min-w-0 overflow-hidden">
                <span class="text-[10px] md:text-xs font-black text-brand-accent tracking-[0.3em] uppercase flex items-center gap-2 mb-1">
                    <span class="relative flex h-2 w-2 items-center justify-center">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-accent opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-brand-accent shadow-[0_0_8px_rgba(255,59,59,0.8)]"></span>
                    </span>
                    NOW PLAYING
                </span>
                
                <div class="player-marquee-container relative w-full overflow-hidden h-5 md:h-7">
                    <div class="player-marquee-inner flex whitespace-nowrap italic font-black text-white text-xs md:text-lg uppercase">
                        <span class="pr-10 marquee-text-source" data-default={displayInfo}>{displayInfo}</span>
                        <span class="pr-10">{displayInfo}</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex md:justify-center flex-shrink-0">
            <button id="master-play-btn" class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-brand-accent text-white flex items-center justify-center hover:scale-110 active:scale-90 transition-all border-2 border-brand-accent/50 shadow-[0_0_30px_rgba(255,59,59,0.3)]">
                <i class="fa-solid fa-play ml-1 text-xl md:text-2xl"></i>
            </button>
        </div>

        <div class="hidden md:flex justify-end items-center gap-4">
            <button id="mute-btn" class="text-gray-400 hover:text-white transition-colors">
                <i id="volume-icon" class="fa-solid fa-volume-high text-lg"></i>
            </button>
            <div class="w-24 lg:w-32 flex items-center">
                <input id="volume-slider" class="premium-slider" type="range" min="0" max="1" step="0.01" value="0.8">
            </div>
        </div>

    </div>
    <div class="h-[env(safe-area-inset-bottom)] w-full"></div>
    
    <audio id="stream-audio" crossorigin="anonymous" transition:persist></audio>
</div>

<script>
    declare global {
        interface Window {
            __eventListenersBound?: boolean;
            __azuracastSSEActive?: boolean;
            __mediaSessionHandlersSet?: boolean;
        }
    }

    const STREAM_URL = 'https://radio.n8v.uk/listen/n8v/radio.mp3';
    const AZURACAST_API_URL = 'https://radio.n8v.uk/api/nowplaying/1';
    // IMPORTANT: Ensure your image is moved to public/images/n8v.png
    const STATION_LOGO_PATH = '/images/n8v.png';
    let previousVolume = 0.8;

    // --- RECONNECTION & STREAM HEALTH STATE ---
    let userWantsPlayback = false;
    let reconnectAttempts = 0;
    let reconnectTimeoutId: any = null;
    let stallTimeoutId: any = null;
    let isReconnecting = false;

    // --- METADATA STATE ---
    let currentMetadata = {
        title: 'Live Broadcast',
        artist: 'n8v radio',
        album: 'n8v radio - The Next Movement',
        artwork: STATION_LOGO_PATH
    };

    let latestNowPlayingData: any = null;
    let sseSource: EventSource | null = null;
    let fallbackPollIntervalId: any = null;

    function getFreshStreamUrl() {
        const separator = STREAM_URL.includes('?') ? '&' : '?';
        return `${STREAM_URL}${separator}_t=${Date.now()}`;
    }

    function scheduleReconnect() {
        if (!userWantsPlayback) return;
        if (reconnectTimeoutId) clearTimeout(reconnectTimeoutId);

        reconnectAttempts++;
        // Exponential backoff: ~1.2s, 2s, 3.5s, 6s, 10s, 16s, capped at 30s + random jitter
        const baseDelay = 1200;
        const maxDelay = 30000;
        const delay = Math.min(maxDelay, Math.round(baseDelay * Math.pow(1.65, reconnectAttempts - 1))) + Math.floor(Math.random() * 600);

        console.warn(`[n8v Radio] Stream interrupted. Reconnecting in ${(delay / 1000).toFixed(1)}s (Attempt #${reconnectAttempts})...`);
        isReconnecting = true;
        syncAllButtons();

        reconnectTimeoutId = setTimeout(async () => {
            if (!userWantsPlayback) return;
            const audio = document.getElementById('stream-audio') as HTMLAudioElement;
            if (!audio) return;

            try {
                audio.src = getFreshStreamUrl();
                audio.load();
                await audio.play();
                reconnectAttempts = 0;
                isReconnecting = false;
                syncAllButtons();
                console.info("[n8v Radio] Stream connection restored successfully.");
            } catch (err) {
                console.warn("[n8v Radio] Reconnect attempt failed. Retrying with backoff...", err);
                scheduleReconnect();
            }
        }, delay);
    }

    // --- MEDIA SESSION API ---
    function setupMediaSessionHandlers(audio: HTMLAudioElement) {
        if (!('mediaSession' in navigator) || window.__mediaSessionHandlersSet) return;
        window.__mediaSessionHandlersSet = true;

        navigator.mediaSession.setActionHandler('play', async () => {
            userWantsPlayback = true;
            if (!audio.src || audio.src === "") audio.src = getFreshStreamUrl();
            try {
                await audio.play();
            } catch (e) {
                console.error("[n8v Radio] Lock screen play error:", e);
                scheduleReconnect();
            }
        });

        navigator.mediaSession.setActionHandler('pause', () => {
            userWantsPlayback = false;
            isReconnecting = false;
            if (reconnectTimeoutId) clearTimeout(reconnectTimeoutId);
            audio.pause();
            audio.src = "";
            syncAllButtons();
        });

        navigator.mediaSession.setActionHandler('stop', () => {
            userWantsPlayback = false;
            isReconnecting = false;
            if (reconnectTimeoutId) clearTimeout(reconnectTimeoutId);
            audio.pause();
            audio.src = "";
            syncAllButtons();
        });

        navigator.mediaSession.setActionHandler('seekbackward', null);
        navigator.mediaSession.setActionHandler('seekforward', null);
    }

    function updateMediaSession() {
        if (!('mediaSession' in navigator)) return;

        const art = currentMetadata.artwork || STATION_LOGO_PATH;
        navigator.mediaSession.metadata = new MediaMetadata({
            title: currentMetadata.title,
            artist: currentMetadata.artist,
            album: currentMetadata.album,
            artwork: [
                { src: art, sizes: '96x96' },
                { src: art, sizes: '128x128' },
                { src: art, sizes: '192x192' },
                { src: art, sizes: '256x256' },
                { src: art, sizes: '512x512' }
            ]
        });
    }

    // --- AZURACAST NOW PLAYING METADATA LOGIC ---
    function applyNowPlayingData(data: any) {
        if (!data) return;
        latestNowPlayingData = data;

        const live = data.live;
        const isLive = Boolean(live && live.is_live);
        const streamer = live?.streamer_name?.trim() || (isLive ? 'Resident DJ' : '');
        const song = data.now_playing?.song;

        const broadcastStart = Number(live?.broadcast_start || 0);
        const playedAt = Number(data.now_playing?.played_at || 0);

        // A track was actually triggered during this live session only if played_at >= broadcastStart
        // If played_at < broadcastStart, it's leftover metadata from the AutoDJ song played before the DJ joined!
        const isLiveTrack = Boolean(isLive && broadcastStart > 0 && playedAt >= (broadcastStart - 5));

        let displayMarquee = '';
        let metaTitle = 'Live Broadcast';
        let metaArtist = 'n8v radio';
        const metaArt = STATION_LOGO_PATH;

        const rawTitle = song?.title?.trim() || '';
        const rawArtist = song?.artist?.trim() || '';

        // Check if track is a genuine track title and not an offline placeholder
        const isOfflineTrack = !rawTitle || 
                               rawTitle.includes('Offline') || 
                               rawTitle.toLowerCase() === 'offline' ||
                               rawTitle.includes('🔴');

        if (isLive) {
            // Case 1: LIVE DJ STREAMING
            metaArtist = streamer || 'Resident DJ';
            if (isLiveTrack && !isOfflineTrack && rawTitle) {
                metaTitle = rawTitle;
                const artistPart = rawArtist && rawArtist.toLowerCase() !== metaArtist.toLowerCase()
                    ? `${rawArtist} - `
                    : '';
                displayMarquee = `LIVE: ${metaArtist} — ${artistPart}${rawTitle}`;
            } else {
                metaTitle = 'Live Vinyl Selection';
                displayMarquee = `LIVE: ${metaArtist} — LIVE VINYL SELECTION`;
            }
        } else if (!isOfflineTrack && rawTitle) {
            // Case 2: AUTO DJ / PLAYLIST STREAMING (Genuine song playing)
            metaArtist = rawArtist || 'n8v radio';
            metaTitle = rawTitle;
            displayMarquee = rawArtist ? `${rawArtist} - ${rawTitle}` : rawTitle;
        } else {
            // Case 3: Station idle / offline loop -> Display scheduled resident info
            const defaultEl = document.querySelector('.marquee-text-source');
            const defaultText = defaultEl?.getAttribute('data-default') || defaultEl?.textContent || 'RESIDENT DJ - THE N8V SHOW';
            displayMarquee = defaultText;
            metaArtist = 'Resident DJ';
            metaTitle = defaultText;
        }

        currentMetadata = {
            title: metaTitle,
            artist: metaArtist,
            album: 'n8v radio - The Next Movement',
            artwork: metaArt
        };

        // Update marquee spans seamlessly
        const spans = document.querySelectorAll('.player-marquee-inner span');
        spans.forEach((span) => {
            span.textContent = displayMarquee.toUpperCase();
        });

        // Dynamically update Homepage Live Transmission Beacon if present on the page
        const ping = document.getElementById('live-indicator-ping');
        const dot = document.getElementById('live-indicator-dot');
        const text = document.getElementById('live-indicator-text');
        const onAir = document.getElementById('hero-on-air-dj');

        if (text) {
            if (isLive) {
                text.textContent = 'LIVE STUDIO TRANSMISSION';
                ping?.classList.remove('bg-gray-500');
                ping?.classList.add('bg-brand-accent', 'animate-ping');
                dot?.classList.remove('bg-gray-500');
                dot?.classList.add('bg-brand-accent');
                if (onAir) onAir.textContent = streamer || 'Resident DJ';
            } else {
                const isScheduledLive = text.getAttribute('data-scheduled-live') === 'true';
                if (!isScheduledLive) {
                    text.textContent = 'AUTOMATED SIGNAL ACTIVE';
                    ping?.classList.remove('bg-brand-accent', 'animate-ping');
                    ping?.classList.add('bg-gray-500');
                    dot?.classList.remove('bg-brand-accent');
                    dot?.classList.add('bg-gray-500');
                    if (onAir) onAir.textContent = onAir.getAttribute('data-default-dj') || 'n8v radio';
                }
            }
        }

        // Sync MediaSession metadata if currently playing
        const audio = document.getElementById('stream-audio') as HTMLAudioElement;
        if (isStreamActive(audio)) {
            updateMediaSession();
        }
    }

    // --- AZURACAST NOW PLAYING METADATA (REST FALLBACK) ---
    async function fetchNowPlaying() {
        try {
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 6000);
            const res = await fetch(AZURACAST_API_URL, {
                cache: 'no-store',
                signal: controller.signal
            });
            clearTimeout(timeoutId);

            if (!res.ok) return;
            const data = await res.json();
            applyNowPlayingData(data);
        } catch (_) {
            // Silently swallow network / CORS / timeout errors
        }
    }

    // --- AZURACAST REAL-TIME SSE (SERVER-SENT EVENTS) ---
    function initAzuraCastSSE() {
        if (window.__azuracastSSEActive) {
            if (latestNowPlayingData) {
                applyNowPlayingData(latestNowPlayingData);
            } else {
                fetchNowPlaying();
            }
            return;
        }
        window.__azuracastSSEActive = true;

        // 1. Instant initial REST fetch
        fetchNowPlaying();

        // 2. Connect to Centrifugo SSE stream
        if ('EventSource' in window) {
            try {
                const sseUrl = 'https://radio.n8v.uk/api/live/nowplaying/sse?cf_connect=' + encodeURIComponent(JSON.stringify({
                    subs: { 'station:n8v': {} }
                }));

                sseSource = new EventSource(sseUrl);

                sseSource.onmessage = (event) => {
                    try {
                        const parsed = JSON.parse(event.data);
                        // Centrifugo publication extraction
                        const npData = parsed.pub?.data?.np || parsed.pub?.data || parsed.data?.np || parsed.data;
                        if (npData && typeof npData === 'object' && ('station' in npData || 'now_playing' in npData)) {
                            applyNowPlayingData(npData);
                        }
                    } catch (e) {
                        // ignore ping / unparseable message
                    }
                };

                sseSource.onerror = () => {
                    // Browser automatically reconnects EventSource. Fallback heartbeat ensures continuity.
                };
            } catch (err) {
                console.warn('[n8v Radio] SSE initialization error, relying on background heartbeat:', err);
            }
        }

        // 3. Resilient background heartbeat: 30s backup in case SSE is throttled
        if (!fallbackPollIntervalId) {
            fallbackPollIntervalId = setInterval(fetchNowPlaying, 30000);
        }
    }

    function isStreamActive(audio: HTMLAudioElement | null) {
        if (!audio) return false;
        return !audio.paused && !!audio.src && audio.src !== "" && !audio.src.endsWith('/');
    }

    function syncAllButtons() {
        const audio = document.getElementById('stream-audio') as HTMLAudioElement;
        if (!audio) return;

        const active = isStreamActive(audio);
        const vinyl = document.getElementById('player-vinyl');
        const statusIcon = document.getElementById('player-status-icon');
        const masterBtn = document.getElementById('master-play-btn');

        if (active || isReconnecting) {
            vinyl?.classList.remove('pause-spin');
            statusIcon?.classList.replace('hidden', 'flex');

            if (isReconnecting) {
                statusIcon!.innerHTML = '<i class="fa-solid fa-rotate text-brand-accent text-base animate-spin"></i>';
                if (masterBtn?.querySelector('i')) masterBtn.querySelector('i')!.className = 'fa-solid fa-rotate text-lg md:text-xl animate-spin';
            } else {
                statusIcon!.innerHTML = '<i class="fa-solid fa-chart-simple text-brand-accent text-xl animate-pulse"></i>';
                if (masterBtn?.querySelector('i')) masterBtn.querySelector('i')!.className = 'fa-solid fa-stop text-xl md:text-2xl';
                updateMediaSession();
            }
        } else {
            vinyl?.classList.add('pause-spin');
            statusIcon?.classList.replace('flex', 'hidden');
            if (masterBtn?.querySelector('i')) masterBtn.querySelector('i')!.className = 'fa-solid fa-play ml-1 text-xl md:text-2xl';
        }

        document.querySelectorAll('.player-trigger, .nav-player-trigger').forEach((btn: any) => {
            const icon = btn.querySelector('i');
            const textSpan = btn.querySelector('.btn-text');
            const isNav = btn.classList.contains('nav-player-trigger');

            if (isReconnecting) {
                if (icon) icon.className = 'fa-solid fa-rotate fa-spin mr-2';
                if (textSpan) textSpan.textContent = isNav ? 'RECONNECTING' : 'RECONNECTING...';
            } else if (active) {
                if (icon) icon.className = isNav ? 'fa-solid fa-pause btn-icon' : 'fa-solid fa-stop mr-2';
                if (textSpan) textSpan.textContent = isNav ? 'PAUSE' : 'STOP';
            } else {
                if (icon) icon.className = isNav ? 'fa-solid fa-play btn-icon' : 'fa-solid fa-play mr-2';
                if (textSpan) textSpan.textContent = isNav ? 'LISTEN' : 'TUNE IN NOW';
            }
        });
    }

    async function togglePlayback() {
        const audio = document.getElementById('stream-audio') as HTMLAudioElement;
        if (!audio) return;

        const active = isStreamActive(audio);

        if (!active && !isReconnecting) {
            // USER INITIATED PLAYBACK
            userWantsPlayback = true;
            reconnectAttempts = 0;
            isReconnecting = false;
            if (reconnectTimeoutId) clearTimeout(reconnectTimeoutId);

            audio.src = getFreshStreamUrl();
            audio.load();
            try {
                await audio.play();
            } catch (err) {
                console.error("[n8v Radio] Playback error:", err);
                scheduleReconnect();
            }
        } else {
            // USER INITIATED STOP
            userWantsPlayback = false;
            isReconnecting = false;
            reconnectAttempts = 0;
            if (reconnectTimeoutId) clearTimeout(reconnectTimeoutId);
            if (stallTimeoutId) clearTimeout(stallTimeoutId);

            audio.pause();
            audio.src = "";
        }
        syncAllButtons();
    }

    function setPlayerVolume(targetVolume: number) {
        const audio = document.getElementById('stream-audio') as HTMLAudioElement;
        const slider = document.getElementById('volume-slider') as HTMLInputElement;
        const volIcon = document.getElementById('volume-icon');
        if (!audio) return;

        const clamped = Math.max(0, Math.min(1, Math.round(targetVolume * 100) / 100));
        audio.volume = clamped;
        if (clamped > 0) previousVolume = clamped;

        const ACCENT_COLOR = '#ff3b3b';
        const p = clamped * 100;

        if (slider) {
            slider.value = clamped.toString();
            slider.style.background = `linear-gradient(to right, ${ACCENT_COLOR} 0%, ${ACCENT_COLOR} ${p}%, rgba(255,255,255,0.1) ${p}%, rgba(255,255,255,0.1) 100%)`;
        }

        if (volIcon) {
            volIcon.className = clamped === 0 
                ? 'fa-solid fa-volume-xmark text-brand-accent' 
                : clamped < 0.5 
                    ? 'fa-solid fa-volume-low text-gray-300' 
                    : 'fa-solid fa-volume-high text-white';
        }
    }

    function initPlayer() {
        const audio = document.getElementById('stream-audio') as HTMLAudioElement;
        if (!audio) return;

        setupMediaSessionHandlers(audio);
        initAzuraCastSSE();

        if (!window.__eventListenersBound) {
            // Click Delegation
            document.addEventListener('click', async (e) => {
                const target = (e.target as HTMLElement).closest('#master-play-btn, .player-trigger, .nav-player-trigger');
                if (!target) return;
                togglePlayback();
            });

            // Keyboard Controls (Desktop)
            // Spacebar: Play/Pause, M: Mute, Up/Down: Volume (+/- 5%)
            const isTyping = (el: Element | null): boolean => {
                if (!el) return false;
                const tag = el.tagName.toLowerCase();
                if (tag === 'input' || tag === 'textarea' || tag === 'select') return true;
                if (el.getAttribute('contenteditable') === 'true') return true;
                return false;
            };

            document.addEventListener('keydown', (e: KeyboardEvent) => {
                if (isTyping(document.activeElement)) return;

                const currentAudio = document.getElementById('stream-audio') as HTMLAudioElement;
                if (!currentAudio) return;

                if (e.code === 'Space') {
                    e.preventDefault();
                    togglePlayback();
                } else if (e.key === 'm' || e.key === 'M') {
                    e.preventDefault();
                    setPlayerVolume(currentAudio.volume > 0 ? 0 : previousVolume);
                } else if (e.code === 'ArrowUp') {
                    e.preventDefault();
                    setPlayerVolume(currentAudio.volume + 0.05);
                } else if (e.code === 'ArrowDown') {
                    e.preventDefault();
                    setPlayerVolume(currentAudio.volume - 0.05);
                }
            });

            // Resiliency & Health Event Listeners
            audio.addEventListener('play', syncAllButtons);
            audio.addEventListener('pause', syncAllButtons);

            audio.addEventListener('playing', () => {
                if (stallTimeoutId) {
                    clearTimeout(stallTimeoutId);
                    stallTimeoutId = null;
                }
                reconnectAttempts = 0;
                isReconnecting = false;
                syncAllButtons();
            });

            audio.addEventListener('error', (err) => {
                console.warn("[n8v Radio] Audio error encountered:", err);
                if (userWantsPlayback) {
                    scheduleReconnect();
                }
            });

            audio.addEventListener('ended', () => {
                console.warn("[n8v Radio] Stream ended unexpectedly.");
                if (userWantsPlayback) {
                    scheduleReconnect();
                }
            });

            audio.addEventListener('waiting', () => {
                if (userWantsPlayback && !stallTimeoutId) {
                    stallTimeoutId = setTimeout(() => {
                        if (userWantsPlayback && audio.readyState < 3) {
                            console.warn("[n8v Radio] Stream stalled for >6s. Attempting reconnection...");
                            scheduleReconnect();
                        }
                        stallTimeoutId = null;
                    }, 6000);
                }
            });

            window.__eventListenersBound = true;
        }

        // --- Volume Slider Initialization ---
        const slider = document.getElementById('volume-slider') as HTMLInputElement;
        const muteBtn = document.getElementById('mute-btn');

        if (slider) {
            setPlayerVolume(audio.volume);

            slider.oninput = (e) => {
                const v = parseFloat((e.target as HTMLInputElement).value);
                setPlayerVolume(v);
            };

            if (muteBtn) {
                muteBtn.onclick = () => {
                    setPlayerVolume(audio.volume > 0 ? 0 : previousVolume);
                };
            }
        }
        // ------------------------------------

        // Final sync on load to ensure correct state
        syncAllButtons();
    }

    // Using astro:page-load ensures this runs on initial load AND subsequent navigations
    document.addEventListener('astro:page-load', initPlayer);
</script>

<style is:global>
    /* ACCENTED SLIDER BASE STYLES */
    .premium-slider {
        -webkit-appearance: none; appearance: none;
        width: 100%; height: 4px; border-radius: 999px;
        background: rgba(255,255,255,0.1); outline: none;
        cursor: pointer;
    }
    
    /* CHROME/SAFARI/EDGE THUMB */
    .premium-slider::-webkit-slider-thumb {
        -webkit-appearance: none; appearance: none;
        height: 16px; width: 16px;
        border-radius: 50%; background: #ffffff; cursor: pointer;
        box-shadow: 0 0 10px rgba(255, 59, 59, 0.5); /* Red glow */
        border: none;
        margin: 0; /* Perfectly vertically centered on the 4px track */
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .premium-slider::-webkit-slider-thumb:hover {
        transform: scale(1.15);
        box-shadow: 0 0 14px rgba(255, 59, 59, 0.8);
